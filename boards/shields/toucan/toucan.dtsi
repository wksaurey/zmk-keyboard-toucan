#include <input/processors.dtsi>
#include <dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/pointing.h>
#include <physical_layouts.dtsi>


/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &default_layout;
        //zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

    row-gpios
    = <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    , <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    , <&gpio1 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    ;
    };

    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0   37       0     0     0>
            , <&key_physical_attrs 100 100  100   37       0     0     0>
            , <&key_physical_attrs 100 100  200   12       0     0     0>
            , <&key_physical_attrs 100 100  300    0       0     0     0>
            , <&key_physical_attrs 100 100  400   12       0     0     0>
            , <&key_physical_attrs 100 100  500   24       0     0     0>
            , <&key_physical_attrs 100 100  800   24       0     0     0>
            , <&key_physical_attrs 100 100  900   12       0     0     0>
            , <&key_physical_attrs 100 100 1000    0       0     0     0>
            , <&key_physical_attrs 100 100 1100   12       0     0     0>
            , <&key_physical_attrs 100 100 1200   37       0     0     0>
            , <&key_physical_attrs 100 100 1300   37       0     0     0>
            , <&key_physical_attrs 100 100    0  137       0     0     0>
            , <&key_physical_attrs 100 100  100  137       0     0     0>
            , <&key_physical_attrs 100 100  200  112       0     0     0>
            , <&key_physical_attrs 100 100  300  100       0     0     0>
            , <&key_physical_attrs 100 100  400  112       0     0     0>
            , <&key_physical_attrs 100 100  500  124       0     0     0>
            , <&key_physical_attrs 100 100  800  124       0     0     0>
            , <&key_physical_attrs 100 100  900  112       0     0     0>
            , <&key_physical_attrs 100 100 1000  100       0     0     0>
            , <&key_physical_attrs 100 100 1100  112       0     0     0>
            , <&key_physical_attrs 100 100 1200  137       0     0     0>
            , <&key_physical_attrs 100 100 1300  137       0     0     0>
            , <&key_physical_attrs 100 100    0  237       0     0     0>
            , <&key_physical_attrs 100 100  100  237       0     0     0>
            , <&key_physical_attrs 100 100  200  212       0     0     0>
            , <&key_physical_attrs 100 100  300  200       0     0     0>
            , <&key_physical_attrs 100 100  400  212       0     0     0>
            , <&key_physical_attrs 100 100  500  224       0     0     0>
            , <&key_physical_attrs 100 100  800  224       0     0     0>
            , <&key_physical_attrs 100 100  900  212       0     0     0>
            , <&key_physical_attrs 100 100 1000  200       0     0     0>
            , <&key_physical_attrs 100 100 1100  212       0     0     0>
            , <&key_physical_attrs 100 100 1200  237       0     0     0>
            , <&key_physical_attrs 100 100 1300  237       0     0     0>
            , <&key_physical_attrs 100 100  350  312       0     0     0>
            , <&key_physical_attrs 100 100  450  312    1200   450   412>
            , <&key_physical_attrs 100 100  548  328    2400   548   433>
            , <&key_physical_attrs 100 100  752  328  (-2400)  852   433>
            , <&key_physical_attrs 100 100  850  312  (-1200)  950   412>
            , <&key_physical_attrs 100 100  950  312       0     0     0>
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;
        // | SW1  | SW2  | SW3  | SW4  | SW5  | SW6  |   | SW6  | SW5  | SW4  | SW3  | SW2  | SW1  |
        // | SW7  | SW8  | SW9  | SW10 | SW11 | SW12 |   | SW12 | SW11 | SW10 | SW9  | SW8  | SW7  |
        // | SW13 | SW14 | SW15 | SW16 | SW17 | SW18 |   | SW18 | SW17 | SW16 | SW15 | SW14 | SW13 |
        //                      | SW19 | SW20 | SW21 |   | SW21 | SW20 | SW19 |
                map = <
        RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
        RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
        RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                                RC(3,3) RC(3,4) RC(3,5)  RC(3,6) RC(3,7) RC(3,8)
        >;
    };
};

/ {
    input_processors {
        // Velocity-based cursor acceleration (zmk-pointing-acceleration
        // module, west.yml). Runs AFTER zip_xy_scaler in the listener,
        // so its counts-per-second thresholds are in post-scaler units —
        // the same units for either trackpad. min-factor 1000 keeps slow
        // precise movement EXACTLY as tuned (no deceleration, no change
        // below speed-threshold); fast flicks scale up to 3x. Affects
        // REL_X/REL_Y only (hard-wired in the module) — scroll/zoom
        // untouched. Tune: max-factor (top speed), speed-threshold
        // (where accel starts), acceleration-exponent (2 = curvier).
        // FIRMWARE ACCELERATION REMOVED (2026-08-20 pm, Kolter's call):
        // the keyboard ships FLAT 1:1 counts and Windows "Enhance
        // pointer precision" (which he keeps ON for his desk mouse) is
        // the single ballistics curve — stacking ours under EPP was
        // double acceleration. The vendored processor stays in
        // drivers/input_processor/ (compiles to nothing without a DT
        // node); to revive it, restore the pointer_accel node + listener
        // reference from git history (last curve: 850/1300@500/6000,
        // curve-v4 rationale in that history). Caveat on record: EPP's
        // velocity estimator sees our bursty BLE event arrival — if
        // float persists on the flat setup, that interaction is the
        // prime suspect.

        // Azoteq pinch-zoom: the TPS43 emits zoom as REL_MISC deltas;
        // the mapper (zmk-input-zoom module, west.yml) fires one
        // behavior per `sensitivity` delta units, mapped to
        // Ctrl+Minus / Ctrl+Equal (Windows browser zoom).
        // No-op for the cirque, which never emits REL_MISC.
        //
        // Ctrl+WHEEL bindings were TRIED and REVERTED (2026-08-20, one
        // firmware round): &msc is a timer-driven scroll-while-held
        // behavior, so a macro's instantaneous press+release fires zero
        // wheel ticks — pinch did nothing at the host. Don't re-attempt
        // with macros; it would need a one-shot wheel-report behavior
        // that ZMK v0.3 doesn't have.
        zip_zoom_mapper: zip_zoom_mapper {
            compatible = "zmk,input-processor-zoom";
            #input-processor-cells = <0>;
            event-code = <INPUT_REL_MISC>;
            sensitivity = <10>;
            bindings = <&kp LC(MINUS)>, <&kp LC(EQUAL)>;
            track-remainders;
        };
    };

    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        glidepoint_split: glidepoint_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    glidepoint_listener: glidepoint_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&glidepoint_split>;
        // XY SCALER REMOVED (2026-08-20 pm, scaler consolidation): the
        // 225/100 upscale existed for the cirque; on the azoteq it
        // turned each chip count into a ~2.25px cursor jump — the
        // slow-movement jitter/stepping. XY now passes 1:1 and the
        // azoteq overlay's x/y-resolution carries the full speed
        // calibration at ~1px quantum. NOTE: a cirque right half run
        // against THIS left will move at ~44% speed — the archived
        // firmware-archive/ uf2 pair is the cirque revert path, not a
        // mixed flash.
        // zip_scroll_scaler: scales the azoteq's two-finger scroll
        // (driver emits at 100%, /20 here — central-side so slow
        // scrolls aren't integer-truncated at the source); no-op for
        // the cirque, which never emits REL_WHEEL.
        input-processors = <&zip_scroll_scaler 1 20>, <&zip_zoom_mapper>;
        scroller {
            layers = <2>;
            input-processors = <
                &zip_xy_to_scroll_mapper
                &zip_scroll_scaler 1 7
                &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
            >;
        };
    };
};
